  1401	
  1402	/*
  1403	 * Called when the dentry loses inode.
  1404	 * We use it to clean up silly-renamed files.
  1405	 */
  1406	static void nfs4_dentry_iput(struct dentry *dentry, struct inode *inode)
  1407	{
  1408		if (S_ISDIR(inode->i_mode))
  1409			/* drop any readdir cache as it could easily be old */
  1410			NFS_I(inode)->cache_validity |= NFS_INO_INVALID_DATA;
  1411	
