 #include <linux/seq_file.h>
=20
 #if IS_ENABLED(CONFIG_DRM_DEBUG_DP_MST_TOPOLOGY_REFS)
@@ -2216,19 +2217,21 @@ static void build_mst_prop_path(const struct drm_dp=
_mst_branch *mstb,
